{
  "ConnectionStrings": {
    "IoTMonitor": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "OpenApi": {
    "Enabled": false
  },
  "ReverseProxy": {
    "TerminatesTls": false
  },
  "Authentication": {
    "CookieLifetimeMinutes": 30,
    "BootstrapAdmin": {
      "Enabled": false,
      "Username": "",
      "Password": ""
    }
  },
  "Security": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ],
    "GlobalPermitLimit": 120,
    "LoginPermitLimit": 5,
    "RateLimitWindowSeconds": 60
  },
  "AlertRules": {
    "Enabled": true,
    "TemperatureMinimumCelsius": 10,
    "TemperatureMaximumCelsius": 35,
    "TemperatureCriticalMinimumCelsius": 0,
    "TemperatureCriticalMaximumCelsius": 45,
    "HumidityMinimumPercent": 30,
    "HumidityMaximumPercent": 75,
    "HumidityCriticalMinimumPercent": 15,
    "HumidityCriticalMaximumPercent": 90
  },
  "DemoData": {
    "Enabled": false,
    "DevicePrefix": "sim-device",
    "DeviceCount": 3
  },
  "Mqtt": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "iot-monitor-api",
    "Username": "",
    "Password": "",
    "TopicFilter": "devices/+/telemetry",
    "ReconnectDelaySeconds": 5,
    "DuplicateWindowMinutes": 10,
    "MaxTrackedMessageIds": 10000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*"
}

# Local development only. Copy this file to .env and replace every example password.
POSTGRES_DB=iot_monitor
POSTGRES_USER=iot_monitor
POSTGRES_PASSWORD=replace_With1!LocalDatabasePassword
POSTGRES_PORT=5433

MQTT_USERNAME=iot_monitor
MQTT_PASSWORD=replace_With1!LocalBrokerPassword
MQTT_PORT=1883
# Keep loopback for normal local use. Set this to the computer's private IPv4
# only when testing an MQTT client on the same trusted Wi-Fi.
MQTT_BIND_ADDRESS=127.0.0.1

# The API creates this account only when the normalized username does not exist.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_With1!StrongAdminPassword

# Browser entry points bind to loopback only. HTTP redirects to HTTPS.
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443

# Compose seeds matching devices so MQTT telemetry is visible immediately.
DEMO_DATA_ENABLED=true
SIMULATOR_DEVICE_PREFIX=sim-device
SIMULATOR_DEVICE_COUNT=3
SIMULATOR_INTERVAL_SECONDS=5
